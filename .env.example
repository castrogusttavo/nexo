# Node
NODE_ENV=development

# DB Config
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME
# Opcional — PgBouncer em modo transação na frente do Postgres (ver
# docker-compose.infra.yml, serviço nexo-pgbouncer). Sem isso setado, o
# runtime bate direto em DATABASE_URL, comportamento idêntico ao atual.
# DATABASE_URL_POOLED=postgresql://USER:PASSWORD@localhost:6432/DB_NAME
# Opcional — réplica de leitura do Postgres (ver docker-compose.infra.yml,
# serviço nexo-db-replica). Sem isso setado, leituras continuam no
# primário, comportamento idêntico ao atual.
# DATABASE_URL_REPLICA=postgresql://USER:PASSWORD@localhost:5434/DB_NAME
REPLICATOR_PASSWORD=

# Redis Config
REDIS_URL=redis://:PASSWORD@localhost:6379
REDIS_PASSWORD=
REDIS_SENTINEL_HOSTS=nexo-sentinel-1:26379,nexo-sentinel-2:26379,nexo-sentinel-3:26379
REDIS_SENTINEL_NAME=mymaster
REDIS_SENTINEL_PASSWORD=

# Services Config
MINIO_ENDPOINT=http://localhost:9000
MINIO_USER=
MINIO_PASSWORD=

# Auth Config
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Versioned secrets for OAuth-token encryption at rest (account.encryptOAuthTokens).
# Format: "<version>:<secret>[,<version>:<secret>]" — first entry is the current key.
# Keep old versions in the list until all encrypted payloads have rotated.
# Generate a secret: openssl rand -hex 32
# BETTER_AUTH_SECRETS=1:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Config
RESEND_API_KEY=

# Axiom
NEXT_PUBLIC_AXIOM_TOKEN=
NEXT_PUBLIC_AXIOM_DATASET=nexo-app

# Icons
HUGEICONS_TOKEN=

# Status Page
STATUS_COLLECTOR_SECRET=

# Slack alerts (optional) -- Incoming Webhook that receives status component
# transitions and background job deaths. Unset disables alerts (logged no-op).
# Production gets it from the CI's SLACK_WEBHOOK_URL secret at deploy time.
# SLACK_ALERTS_WEBHOOK_URL=

# Account Lifecycle
# Optional dev/staging override (in ms) for the 30-day account deletion
# grace period. Ignored in tests. Example: 60000 = 1 minute.
# ACCOUNT_DELETION_GRACE_OVERRIDE_MS=
# Workbench dashboard auth
WORKBENCH_USER=admin
WORKBENCH_PASS=pass
# BullMQ Redis connection
REDIS_URL=redis://localhost:6379

# Platform Admin
PLATFORM_ADMIN_EMAILS=admin@empresa.com

# Wiki realtime (Hocuspocus)
REALTIME_PORT=1234
NEXT_PUBLIC_REALTIME_URL=ws://localhost:1234

# PostHog (product analytics, optional) -- unset means PostHog never loads and
# never requests anything, which is how dev, CI and the test suites run. The
# key is public (it ships in the client bundle); it only allows writing events.
# The browser talks to /ingest on our own origin, which next.config.ts rewrites
# to NEXT_PUBLIC_POSTHOG_HOST (defaults to PostHog's EU ingestion host).
# NEXT_PUBLIC_POSTHOG_KEY=phc_
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry (error tracking, optional) -- unset means the SDK is never loaded and
# nothing is sent. The DSN is public by design (it ships in the client bundle)
# and only allows submitting events.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o0.ingest.de.sentry.io/0
# Tags every event with the commit that shipped it. CD passes the git SHA as a
# Docker build arg; leave it unset locally.
# NEXT_PUBLIC_SENTRY_RELEASE=
# Defaults to NODE_ENV. Set it when a deployment needs its own name (staging).
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Build-time only, and only for uploading source maps. Absent = no upload, and
# the build must never fail for it. SENTRY_AUTH_TOKEN is a credential: it is a
# GitHub secret handed to the image build as a BuildKit secret, never a plain
# build arg (those stay readable in the image history).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
