# Node
NODE_ENV=development

# DB Config
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME

# Redis Config
REDIS_URL=redis://:PASSWORD@localhost:6379
REDIS_PASSWORD=
REDIS_SENTINEL_HOSTS=nexo-sentinel-1:26379,nexo-sentinel-2:26379,nexo-sentinel-3:26379
REDIS_SENTINEL_NAME=mymaster
REDIS_SENTINEL_PASSWORD=

# Services Config
MINIO_ENDPOINT=http://localhost:9000
MINIO_USER=
MINIO_PASSWORD=

# Auth Config
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Versioned secrets for OAuth-token encryption at rest (account.encryptOAuthTokens).
# Format: "<version>:<secret>[,<version>:<secret>]" — first entry is the current key.
# Keep old versions in the list until all encrypted payloads have rotated.
# Generate a secret: openssl rand -hex 32
# BETTER_AUTH_SECRETS=1:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Config
RESEND_API_KEY=

# Axiom
NEXT_PUBLIC_AXIOM_TOKEN=
NEXT_PUBLIC_AXIOM_DATASET=nexo-app

# Icons
HUGEICONS_TOKEN=

# Status Page
STATUS_COLLECTOR_SECRET=

# Account Lifecycle
# Optional dev/staging override (in ms) for the 30-day account deletion
# grace period. Ignored in tests. Example: 60000 = 1 minute.
# ACCOUNT_DELETION_GRACE_OVERRIDE_MS=
# Workbench dashboard auth
WORKBENCH_USER=admin
WORKBENCH_PASS=pass
# BullMQ Redis connection
REDIS_URL=redis://localhost:6379

# Platform Admin
PLATFORM_ADMIN_EMAILS=admin@empresa.com
