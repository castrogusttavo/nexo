# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
.env
!.env.example

# secrets (SOPS + age)
secrets/*.env
!secrets/*.enc.env
*.key

# redis TLS certs (generated locally, never committed)
redis-tls/*
!redis-tls/generate.sh

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static

# lighthouse CI
.lighthouseci/

# load test seed manifest (local credentials, regenerate with pnpm seed:load-test)
scripts/.load-test-manifest.json

# k6 run outputs (raw JSON exports for building graphs)
k6/results/

# AI Agents & Skills
.agents*
.claude
/docs
CLAUDE.md
.aider*
