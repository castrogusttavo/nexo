generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]
  twoFactors  TwoFactor[]
  shortLinks  ShortLink[]

  @@map("users")
}

model TwoFactor {
  id          String   @id @default(cuid())
  secret      String
  backupCodes String   @map("backup_codes")
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("two_factors")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verifications")
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  activePlan    Plan           @default(BASIC) @map("active_plan")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  memberships   Membership[]
  subscriptions Subscription[]

  @@map("workspaces")
}

model Membership {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Subscription {
  id          String             @id @default(cuid())
  billId      String             @unique @map("bill_id")
  plan        Plan
  status      SubscriptionStatus @default(PENDING)
  amount      Int
  paymentUrl  String             @map("payment_url")
  workspaceId String             @map("workspace_id")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("subscriptions")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Plan {
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum ComponentStatus {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
  MAINTENANCE
}

model HealthCheck {
  id           String          @id @default(cuid())
  componentKey String          @map("component_key")
  status       ComponentStatus
  latencyMs    Int             @map("latency_ms")
  error        String?
  checkedAt    DateTime        @default(now()) @map("checked_at")

  @@index([componentKey, checkedAt])
  @@index([checkedAt])
  @@map("health_checks")
}

model ComponentDaily {
  id           String          @id @default(cuid())
  componentKey String          @map("component_key")
  day          DateTime        @db.Date
  worstStatus  ComponentStatus @map("worst_status")
  totalChecks  Int             @map("total_checks")
  upChecks     Int             @map("up_checks")
  uptimePct    Decimal         @map("uptime_pct") @db.Decimal(6, 3)
  avgLatencyMs Int             @map("avg_latency_ms")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([componentKey, day])
  @@index([componentKey, day])
  @@map("component_dailies")
}

enum IncidentEvent {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

model Incident {
  id           String           @id @default(cuid())
  componentKey String           @map("component_key")
  severity     ComponentStatus
  title        String
  startedAt    DateTime         @map("started_at")
  resolvedAt   DateTime?        @map("resolved_at")
  updates      IncidentUpdate[]

  @@index([componentKey, startedAt])
  @@index([resolvedAt])
  @@index([startedAt])
  @@map("incidents")
}

model IncidentUpdate {
  id         String        @id @default(cuid())
  incidentId String        @map("incident_id")
  event      IncidentEvent
  message    String
  postedAt   DateTime      @default(now()) @map("posted_at")
  incident   Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, postedAt])
  @@map("incident_updates")
}

model ShortLink {
  id        String        @id @default(cuid())
  title     String        @map("title")
  url       String        @map("url")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id])
  userId    String        @map("user_id")

  @@index([createdAt])
  @@map("short_links")
}
