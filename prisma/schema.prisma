generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  username            String               @unique
  emailVerified       Boolean              @default(false) @map("email_verified")
  image               String?
  coverImage          String?              @map("cover_image")
  twoFactorEnabled    Boolean              @default(false) @map("two_factor_enabled")
  deletionScheduledAt DateTime?            @map("deletion_scheduled_at")
  acceptedTermsAt     DateTime?            @map("accepted_terms_at")
  acceptedPrivacyAt   DateTime?            @map("accepted_privacy_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  onboardingStep      OnboardingStep?      @default(PROFILE) @map("onboarding_step")
  role                UserRole?            @map("role")
  goals               UserGoal[]           @map("goals")
  preference          UserPreference?
  notificationSetting NotificationSetting?

  memberships        Membership[]
  sessions           Session[]
  accounts           Account[]
  twoFactors         TwoFactor[]
  shortLinks         ShortLink[]
  stickyNotes        StickyNote[]
  consentEvents      ConsentEvent[]
  projectsLed        Project[]             @relation("ProjectLead")
  projectMemberships ProjectMember[]
  projectFavourites  ProjectFavorite[]
  sentInvitations    WorkspaceInvitation[] @relation("SentInvitations")
  modulesLed         Module[]              @relation("ModuleLead")
  moduleMemberships  ModuleMember[]
  moduleFavourites   ModuleFavorite[]
  cyclesLed          Cycle[]               @relation("CycleLead")
  cycleMemberships   CycleMember[]
  issuesAuthored     Issue[]               @relation("IssueAuthor")
  issueAssignments   IssueAssignee[]       @relation("IssueAssignee")
  issueSubscriptions IssueSubscriber[]     @relation("IssueSubscriber")
  attachments        Attachment[]
  votes              IssueVote[]
  comments           Comment[]
  activities         Activity[]
  issueUpdates       IssueUpdate[]
  createdWikiPages   WikiPage[]            @relation("WikiPageAuthor")
  updatedWikiPages   WikiPage[]            @relation("WikiPageEditor")

  @@index([deletionScheduledAt])
  @@map("users")
}

enum ConsentDocument {
  TERMS
  PRIVACY
  COOKIES
}

enum ConsentAction {
  GRANTED
  REVOKED
}

enum OnboardingStep {
  PROFILE
  ROLE
  BRINGS
  WORKSPACE
}

enum UserRole {
  PRODUCT_MANAGER
  ENGINEERING_MANAGER
  DESIGNER
  DEVELOPER
  FOUNDER_EXECUTIVE
  OPERATIONS_MANAGER
  OTHER
}

enum UserGoal {
  ROADMAP
  SPRINTS
  CROSS_FUNCTIONAL
  REPLACE_TOOL
  EXPLORING
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum QuickSendShortcut {
  ENTER
  CTRL_ENTER
}

model UserPreference {
  id                String            @id @default(cuid())
  userId            String            @unique @map("user_id")
  theme             Theme             @default(SYSTEM)
  smoothCursor      Boolean           @default(false) @map("smooth_cursor")
  quickSendShortcut QuickSendShortcut @default(ENTER) @map("quick_send_shortcut")
  timezone          String            @default("UTC")
  weekStartsOn      Int               @default(1) @map("week_starts_on")
  weekendDays       Int[]             @default([0, 6]) @map("weekend_days")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationSetting {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  priorityChanges Boolean  @default(true) @map("priority_changes")
  stateChanges    Boolean  @default(true) @map("state_changes")
  comments        Boolean  @default(true)
  mentions        Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_setting")
}

model ConsentEvent {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  document  ConsentDocument
  version   String
  action    ConsentAction
  ipAddress String?         @map("ip_address")
  userAgent String?         @map("user_agent")
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, document, createdAt])
  @@map("consent_events")
}

model TwoFactor {
  id          String   @id @default(cuid())
  secret      String
  backupCodes String   @map("backup_codes")
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("two_factors")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verifications")
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  activePlan    Plan           @default(FREE) @map("active_plan")
  trialEndsAt   DateTime?      @map("trial_ends_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  memberships   Membership[]
  subscriptions Subscription[]
  projects      Project[]

  invitations WorkspaceInvitation[]
  wikiPages   WikiPage[]

  @@map("workspaces")
}

model Membership {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Subscription {
  id          String             @id @default(cuid())
  billId      String             @unique @map("bill_id")
  plan        Plan
  status      SubscriptionStatus @default(PENDING)
  amount      Int
  seats       Int                @default(1)
  interval    BillingInterval    @default(MONTHLY)
  coupon      String?
  paymentUrl  String             @map("payment_url")
  workspaceId String             @map("workspace_id")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("subscriptions")
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model WorkspaceInvitation {
  id          String       @id @default(cuid())
  email       String
  role        Role         @default(MEMBER)
  token       String       @unique @default(cuid())
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime     @map("expiresa_at")
  invitedById String       @map("invited_by_id")
  workspaceId String       @map("workspace_id")
  projectId   String?      @map("project_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email])
  @@map("workspace_invitations")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Plan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ComponentStatus {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
  MAINTENANCE
}

model HealthCheck {
  id           String          @id @default(cuid())
  componentKey String          @map("component_key")
  status       ComponentStatus
  latencyMs    Int             @map("latency_ms")
  error        String?
  checkedAt    DateTime        @default(now()) @map("checked_at")

  @@index([componentKey, checkedAt])
  @@index([checkedAt])
  @@map("health_checks")
}

model ComponentDaily {
  id           String          @id @default(cuid())
  componentKey String          @map("component_key")
  day          DateTime        @db.Date
  worstStatus  ComponentStatus @map("worst_status")
  totalChecks  Int             @map("total_checks")
  upChecks     Int             @map("up_checks")
  uptimePct    Decimal         @map("uptime_pct") @db.Decimal(6, 3)
  avgLatencyMs Int             @map("avg_latency_ms")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([componentKey, day])
  @@index([componentKey, day])
  @@map("component_dailies")
}

enum IncidentEvent {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

model Incident {
  id           String           @id @default(cuid())
  componentKey String           @map("component_key")
  severity     ComponentStatus
  title        String
  startedAt    DateTime         @map("started_at")
  resolvedAt   DateTime?        @map("resolved_at")
  updates      IncidentUpdate[]

  @@index([componentKey, startedAt])
  @@index([resolvedAt])
  @@index([startedAt])
  @@map("incidents")
}

model IncidentUpdate {
  id         String        @id @default(cuid())
  incidentId String        @map("incident_id")
  event      IncidentEvent
  message    String
  postedAt   DateTime      @default(now()) @map("posted_at")
  incident   Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, postedAt])
  @@map("incident_updates")
}

model ShortLink {
  id        String   @id @default(cuid())
  title     String   @map("title")
  url       String   @map("url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  @@index([createdAt])
  @@map("short_links")
}

enum StickyColor {
  RED
  YELLOW
  BLUE
  GREEN
  PURPLE
  ZINC
}

model StickyNote {
  id        String      @id @default(cuid())
  content   Json        @map("content")
  color     StickyColor @default(ZINC) @map("color")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  @@index([userId, updatedAt])
  @@map("sticky_notes")
}

model Project {
  id                String    @id @default(cuid())
  name              String
  slug              String
  identifier        String    @map("identifier")
  description       String?
  emoji             String?
  coverImage        String?   @map("cover_image")
  isPublic          Boolean   @default(false) @map("is_public")
  issueTypesEnabled Boolean   @default(true) @map("issue_types_enabled")
  modulesEnabled    Boolean   @default(true) @map("modules_enabled")
  cyclesEnabled     Boolean   @default(true) @map("cycles_enabled")
  estimatesEnabled  Boolean   @default(true) @map("estimates_enabled")
  issueSequence     Int       @default(0) @map("issue_sequence")
  leadId            String    @map("lead_id")
  workspaceId       String    @map("workspace_id")
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  lead             User                  @relation("ProjectLead", fields: [leadId], references: [id])
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  favourites       ProjectFavorite[]
  invitations      WorkspaceInvitation[]
  states           State[]
  labels           Label[]
  estimateSettings EstimateSettings?
  modules          Module[]
  cycles           Cycle[]
  issueTypes       IssueType[]
  issues           Issue[]

  @@unique([workspaceId, slug])
  @@unique([workspaceId, identifier])
  @@index([workspaceId, archivedAt])
  @@index([leadId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model ProjectFavorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("project_favorites")
}

model CareerJob {
  id             String               @id @default(cuid())
  slug           String               @unique
  title          String
  department     String?
  summary        String
  content        Json                 @map("content")
  location       String?              @map("location")
  locationType   CareerLocationType   @default(REMOTE) @map("location_type")
  employmentType CareerEmploymentType @default(CONTRACT) @map("employment_type")
  status         CareerJobStatus      @default(DRAFT) @map("status")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  applications CareerApplication[]

  @@map("career_jobs")
}

model CareerApplication {
  id              String                  @id @default(cuid())
  jobId           String                  @map("job_id")
  name            String
  email           String
  phone           String?
  linkedinUrl     String?                 @map("linkedin_url")
  portfolioUrl    String?                 @map("portfolio_url")
  lastJobTitle    String?                 @map("last_job_title")
  experienceYears Int?                    @map("experience_years")
  message         String?
  resumeBucket    String                  @map("resume_bucket")
  resumeKey       String                  @map("resume_key")
  resumeFileName  String                  @map("resume_file_name")
  consentAt       DateTime                @map("consent_at")
  ipAddress       String                  @map("ip_address")
  status          CareerApplicationStatus @default(RECEIVED) @map("status")
  createdAt       DateTime                @default(now()) @map("created_at")

  job CareerJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdAt])
  @@map("career_applications")
}

enum CareerJobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum CareerApplicationStatus {
  RECEIVED
  REVIEWING
  REJECTED
  HIRED
}

enum CareerLocationType {
  REMOTE
  HYBRID
  ON_SITE
}

enum CareerEmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  TEMPORARY
}

model State {
  id          String     @id @default(cuid())
  name        String
  description String?
  group       StateGroup
  color       TagColor   @default(ZINC)
  order       Int        @default(0)
  isDefault   Boolean    @default(false) @map("is_default")
  projectId   String     @map("project_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId, group])
  @@map("states")
}

enum StateGroup {
  BACKLOG
  UNSTARTED
  STARTED
  COMPLETED
  CANCELLED
}

enum TagColor {
  RED
  YELLOW
  BLUE
  GREEN
  PURPLE
  ZINC
}

model Label {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       TagColor @default(ZINC)
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@index([projectId])
  @@map("labels")
}

model EstimateValue {
  id                 String   @id @default(cuid())
  value              String
  order              Int      @default(0)
  estimateSettingsId String   @map("estimate_settings_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  estimateSettings EstimateSettings @relation(fields: [estimateSettingsId], references: [id], onDelete: Cascade)
  issues           Issue[]

  @@index([estimateSettingsId])
  @@map("estimate_values")
}

model EstimateSettings {
  id        String         @id @default(cuid())
  system    EstimateSystem @default(POINTS)
  model     EstimateModel  @default(FIBONACCI)
  projectId String         @unique @map("project_id")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  EstimateValue[]

  @@map("estimate_settings")
}

enum EstimateSystem {
  POINTS
  CATEGORIES
  TIME
}

enum EstimateModel {
  FIBONACCI
  LINEAR
  SQUARES
  T_SHIRT_SIZES
  EASY_TO_HARD
  HOURS
}

model Module {
  id        String       @id @default(cuid())
  name      String
  progress  Int          @default(0)
  status    ModuleStatus @default(BACKLOG)
  startDate DateTime?    @map("start_date")
  endDate   DateTime?    @map("end_date")
  leadId    String       @map("lead_id")
  projectId String       @map("project_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  lead       User             @relation("ModuleLead", fields: [leadId], references: [id])
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members    ModuleMember[]
  favourites ModuleFavorite[]
  issues     Issue[]

  @@index([projectId, status])
  @@index([leadId])
  @@map("modules")
}

model ModuleMember {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  moduleId  String   @map("module_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@map("module_members")
}

model ModuleFavorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  moduleId  String   @map("module_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@map("module_favorites")
}

enum ModuleStatus {
  BACKLOG
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum CycleStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Cycle {
  id          String      @id @default(cuid())
  name        String
  description String?
  status      CycleStatus @default(NOT_STARTED)
  startDate   DateTime?   @map("start_date")
  endDate     DateTime?   @map("end_date")
  leadId      String      @map("lead_id")
  projectId   String      @map("project_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  lead    User          @relation("CycleLead", fields: [leadId], references: [id])
  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members CycleMember[]
  issues  Issue[]

  @@index([projectId, status])
  @@index([leadId])
  @@map("cycles")
}

model CycleMember {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  cycleId   String   @map("cycle_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle Cycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleId])
  @@index([cycleId])
  @@index([userId])
  @@map("cycle_members")
}

model IssueType {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       TagColor @default(ZINC)
  icon        String
  isSystem    Boolean  @default(false) @map("is_system")
  order       Int      @default(0)
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
  @@map("issue_types")
}

model Issue {
  id              String        @id @default(cuid())
  number          Int
  title           String
  description     Json
  priority        IssuePriority @default(NONE)
  startDate       DateTime?     @map("start_date")
  dueDate         DateTime?     @map("due_date")
  stateId         String        @map("state_id")
  typeId          String        @map("type_id")
  cycleId         String?       @map("cycle_id")
  moduleId        String?       @map("module_id")
  estimateValueId String?       @map("estimate_value_id")
  authorId        String        @map("author_id")
  projectId       String        @map("project_id")
  parentId        String?       @map("parent_id")
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  state            State             @relation(fields: [stateId], references: [id])
  type             IssueType         @relation(fields: [typeId], references: [id])
  author           User              @relation("IssueAuthor", fields: [authorId], references: [id])
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees        IssueAssignee[]
  subscribers      IssueSubscriber[]
  labels           IssueLabel[]
  cycle            Cycle?            @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  module           Module?           @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  estimateValue    EstimateValue?    @relation(fields: [estimateValueId], references: [id], onDelete: SetNull)
  parent           Issue?            @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Issue[]           @relation("IssueHierarchy")
  dependenciesFrom IssueDependency[] @relation("IssueDependencySource")
  dependenciesTo   IssueDependency[] @relation("IssueDependencyTarget")
  relationsFrom    IssueRelation[]   @relation("IssueRelationSource")
  relationsTo      IssueRelation[]   @relation("IssueRelationTarget")
  attachments      Attachment[]
  votes            IssueVote[]
  comments         Comment[]
  updates          IssueUpdate[]

  @@unique([projectId, number])
  @@index([projectId, deletedAt])
  @@index([stateId])
  @@index([typeId])
  @@index([cycleId])
  @@index([moduleId])
  @@index([parentId])
  @@map("issues")
}

enum IssuePriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model IssueAssignee {
  id        String   @id @default(cuid())
  issueId   String   @map("issue_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation("IssueAssignee", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([issueId])
  @@index([userId])
  @@map("issue_assignees")
}

model IssueSubscriber {
  id        String   @id @default(cuid())
  issueId   String   @map("issue_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation("IssueSubscriber", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([issueId])
  @@index([userId])
  @@map("issue_subscribers")
}

model IssueLabel {
  id        String   @id @default(cuid())
  issueId   String   @map("issue_id")
  labelId   String   @map("label_id")
  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
  @@index([issueId])
  @@index([labelId])
  @@map("issue_labels")
}

enum IssueDependencyType {
  BLOCKS
  STARTS_BEFORE
  FINISHES_BEFORE
}

model IssueDependency {
  id        String              @id @default(cuid())
  sourceId  String              @map("source_id")
  targetId  String              @map("target_id")
  type      IssueDependencyType
  createdAt DateTime            @default(now()) @map("created_at")

  source Issue @relation("IssueDependencySource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Issue @relation("IssueDependencyTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
  @@map("issue_dependencies")
}

model IssueRelation {
  id        String            @id @default(cuid())
  sourceId  String            @map("source_id")
  targetId  String            @map("target_id")
  type      IssueRelationType
  createdAt DateTime          @default(now()) @map("created_at")

  source Issue @relation("IssueRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Issue @relation("IssueRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
  @@map("issue_relations")
}

enum IssueRelationType {
  RELATES_TO
  IMPLEMENTS
}

model Attachment {
  id           String   @id @default(cuid())
  fileName     String   @map("file_name")
  contentType  String   @map("content_type")
  size         Int
  bucket       String
  key          String
  issueId      String   @map("issue_id")
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  issue      Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id])

  @@index([issueId])
  @@map("attachments")
}

model IssueVote {
  id        String        @id @default(cuid())
  issueId   String        @map("issue_id")
  userId    String        @map("user_id")
  type      IssueVoteType
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([issueId])
  @@map("issue_votes")
}

enum IssueVoteType {
  UP
  DOWN
}

model Comment {
  id        String    @id @default(cuid())
  content   Json
  issueId   String    @map("issue_id")
  authorId  String    @map("author_id")
  parentId  String?   @map("parent_id")
  editedAt  DateTime? @map("edited_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  issue   Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentThread")

  @@index([issueId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model Activity {
  id         String             @id @default(cuid())
  entityType ActivityEntityType @map("entity_type")
  entityId   String             @map("entity_id")
  actorId    String             @map("actor_id")
  field      String
  oldValue   Json?              @map("old_value")
  newValue   Json?              @map("new_value")
  createdAt  DateTime           @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@map("activities")
}

enum ActivityEntityType {
  ISSUE
  CYCLE
  MODULE
}

model IssueUpdate {
  id        String            @id @default(cuid())
  status    IssueUpdateStatus
  content   String?
  issueId   String            @map("issue_id")
  authorId  String            @map("author_id")
  editedAt  DateTime?         @map("edited_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([issueId, createdAt])
  @@map("issue_updates")
}

enum IssueUpdateStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

model WikiPage {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  parentId    String?   @map("parent_id")
  title       String
  icon        String?
  coverImage  String?   @map("cover_image")
  content     Json
  yjsState    Bytes?    @map("yjs_state")
  position    Int       @default(0)
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    WikiPage?  @relation("WikiPageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  WikiPage[] @relation("WikiPageTree")
  createdBy User       @relation("WikiPageAuthor", fields: [createdById], references: [id])
  updatedBy User?      @relation("WikiPageEditor", fields: [updatedById], references: [id])
}
