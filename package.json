{
  "name": "nexo",
  "version": "0.1.0",
  "description": "AI-native, multi-tenant project management platform — an open-source alternative to Linear, Jira, and Asana.",
  "license": "AGPL-3.0-only",
  "homepage": "https://nexopm.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/castrogusttavo/nexo.git"
  },
  "bugs": {
    "url": "https://github.com/castrogusttavo/nexo/issues"
  },
  "keywords": [
    "project-management",
    "issue-tracker",
    "multi-tenant",
    "nextjs",
    "typescript",
    "postgresql",
    "prisma",
    "redis",
    "bullmq",
    "self-hosted",
    "open-source"
  ],
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm infra && node scripts/next-banner.mjs dev",
    "infra": "pnpm docker:start && pnpm prisma:migrate:dev",
    "build": "prisma generate && next build",
    "start": "node scripts/next-banner.mjs start -H 0.0.0.0 -p 3000",
    "check": "biome check --fix",
    "check:ci": "biome check",
    "check:staged": "biome check --fix --staged --no-errors-on-unmatched",
    "lint": "biome lint --write",
    "format": "biome format --write && prisma format",
    "format:check": "biome format",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration",
    "test:e2e": "vitest --project e2e",
    "test:component": "vitest --project component",
    "test:contract": "vitest --project contract",
    "test:browser": "playwright test --project=chromium",
    "test:visual": "e2e/visual/run-in-docker.sh",
    "test:visual:update": "e2e/visual/run-in-docker.sh --update-snapshots",
    "test:mutation": "stryker run",
    "test:unit:watch": "vitest --project unit --watch",
    "test:unit:coverage": "vitest --project unit --coverage",
    "test:all": "vitest --run",
    "test:ci": "vitest --run --coverage",
    "test:coverage": "vitest --run --coverage --project unit --project integration",
    "test:coverage:component": "COVERAGE_SCOPE=frontend vitest --run --coverage --project component",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "docker:create": "docker compose --env-file .env -f infra/dev.yml up -d",
    "docker:start": "docker compose --env-file .env -f infra/dev.yml start",
    "docker:stop": "docker compose --env-file .env -f infra/dev.yml stop",
    "worker:dev": "tsx --tsconfig tsconfig.worker.json --env-file=.env --watch worker/index.ts",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --target=node20 --alias:server-only=./worker/server-only.shim.ts --outfile=dist/worker.cjs --external:argon2 --external:@prisma/client --external:.prisma/client",
    "worker": "node dist/worker.cjs",
    "status:collect": "tsx --tsconfig tsconfig.worker.json --env-file=.env worker/status-collect.ts",
    "status:watch": "tsx --tsconfig tsconfig.worker.json --env-file=.env worker/status-collect.ts --watch",
    "seed:preview": "tsx --env-file=.env scripts/seed-preview-data.ts",
    "seed:load-test": "tsx --env-file=.env scripts/seed-load-test.ts",
    "prepare": "husky",
    "email": "ESBUILD_BINARY_PATH=$(node scripts/resolve-esbuild-binary.mjs) npx email dev --dir components/emails --port 3001",
    "realtime:dev": "tsx --tsconfig tsconfig.worker.json --env-file=.env --watch realtime/index.ts",
    "realtime:build": "esbuild realtime/index.ts --bundle --platform=node --target=node20 --alias:server-only=./realtime/server-only.shim.ts --outfile=dist/realtime.cjs --external:argon2 --external:@prisma/client --external:.prisma/client",
    "realtime": "node dist/realtime.cjs"
  },
