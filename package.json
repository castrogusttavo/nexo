{
  "name": "nexo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm infra && pnpm next dev",
    "infra": "pnpm docker:start && pnpm prisma:migrate:dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "check": "biome check --fix",
    "check:ci": "biome check",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration",
    "test:e2e": "vitest --project e2e",
    "test:component": "vitest --project component",
    "test:unit:watch": "vitest --project unit --watch",
    "test:unit:coverage": "vitest --project unit --coverage",
    "test:all": "vitest --run",
    "test:ci": "vitest --run --coverage",
    "test:coverage": "vitest --run --coverage --project unit --project integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "docker:create": "docker compose -f docker-compose.infra.yml up -d",
    "docker:start": "docker compose -f docker-compose.infra.yml start",
    "docker:stop": "docker compose -f docker-compose.infra.yml stop",
    "worker:dev": "tsx --tsconfig tsconfig.worker.json --env-file=.env --watch worker/index.ts",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --target=node20 --alias:server-only=./worker/server-only.shim.ts --outfile=dist/worker.cjs --external:argon2 --external:@prisma/client --external:.prisma/client",
    "worker": "node dist/worker.cjs",
    "prepare": "husky",
    "email": "npx email dev --dir components/emails --port 3001"
  },
  "dependencies": {
    "@aws-sdk/s3-request-presigner": "^3.1072.0",
    "@axiomhq/js": "^1.7.0",
    "@axiomhq/logging": "^0.2.2",
    "@axiomhq/nextjs": "^0.2.2",
    "@axiomhq/react": "^0.2.2",
    "@base-ui/react": "^1.6.0",
    "@better-auth/infra": "^0.2.14",
    "@getworkbench/next": "^0.7.0",
    "@hugeicons-pro/core-bulk-rounded": "^4.2.1",
    "@hugeicons-pro/core-solid-rounded": "^4.2.1",
    "@hugeicons-pro/core-stroke-rounded": "^4.2.1",
    "@hugeicons/react": "^1.1.7",
    "@next/third-parties": "^16.2.9",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@scalar/nextjs-api-reference": "^0.10.20",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.0",
    "@tiptap/extension-task-item": "^3.27.0",
    "@tiptap/extension-task-list": "^3.27.0",
    "@tiptap/pm": "^3.27.0",
    "@tiptap/react": "^3.27.0",
    "@tiptap/starter-kit": "^3.27.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "argon2": "^0.44.0",
    "better-auth": "^1.6.19",
    "bullmq": "^5.79.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "eslint-config-next": "^16.2.9",
    "frimousse": "^0.3.0",
    "geist": "^1.7.2",
    "input-otp": "^1.4.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "rate-limiter-flexible": "^11.2.0",
    "react": "19.2.5",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.5",
    "react-email": "^6.6.3",
    "redis": "^5.12.1",
    "resend": "^6.14.0",
    "server-only": "^0.0.1",
    "shadcn": "4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "effect": "^3.21.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "argon2",
      "esbuild",
      "msw",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1072.0",
    "@biomejs/biome": "2.4.13",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@faker-js/faker": "^10.5.0",
    "@react-email/ui": "6.6.3",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "4.1.5",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prisma": "7.8.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
