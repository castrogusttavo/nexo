{
  "name": "nexo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm infra && pnpm next dev",
    "infra": "pnpm docker:start && pnpm prisma:migrate:dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "check": "biome check --fix",
    "check:ci": "biome check",
    "check:staged": "biome check --fix --staged --no-errors-on-unmatched",
    "lint": "biome lint --write",
    "format": "biome format --write && prisma format",
    "format:check": "biome format",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration",
    "test:e2e": "vitest --project e2e",
    "test:component": "vitest --project component",
    "test:unit:watch": "vitest --project unit --watch",
    "test:unit:coverage": "vitest --project unit --coverage",
    "test:all": "vitest --run",
    "test:ci": "vitest --run --coverage",
    "test:coverage": "vitest --run --coverage --project unit --project integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "docker:create": "docker compose -f docker-compose.infra.yml up -d",
    "docker:start": "docker compose -f docker-compose.infra.yml start",
    "docker:stop": "docker compose -f docker-compose.infra.yml stop",
    "worker:dev": "tsx --tsconfig tsconfig.worker.json --env-file=.env --watch worker/index.ts",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --target=node20 --alias:server-only=./worker/server-only.shim.ts --outfile=dist/worker.cjs --external:argon2 --external:@prisma/client --external:.prisma/client",
    "worker": "node dist/worker.cjs",
    "seed:preview": "tsx --env-file=.env scripts/seed-preview-data.ts",
    "seed:load-test": "tsx --env-file=.env scripts/seed-load-test.ts",
    "loadtest": "k6 run k6/flows.js",
    "prepare": "husky",
    "email": "ESBUILD_BINARY_PATH=node_modules/.pnpm/@esbuild+linux-x64@0.28.0/node_modules/@esbuild/linux-x64/bin/esbuild npx email dev --dir components/emails --port 3001",
    "doctor": "npx react-doctor@latest",
    "realtime:dev": "tsx --tsconfig tsconfig.worker.json --env-file=.env --watch realtime/index.ts",
    "realtime:build": "esbuild realtime/index.ts --bundle --platform=node --target=node20 --alias:server-only=./realtime/server-only.shim.ts --outfile=dist/realtime.cjs --external:argon2 --external:@prisma/client --external:.prisma/client",
    "realtime": "node dist/realtime.cjs"
  },
