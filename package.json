{
  "name": "nexo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/dev-banner.js",
    "infra": "pnpm docker:start && pnpm prisma:migrate:dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "check": "biome check --fix",
    "check:ci": "biome check",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "fix:imports": "node scripts/fix-imports.mjs",
    "fix:imports:watch": "node scripts/fix-imports.mjs --watch",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration",
    "test:e2e": "vitest --project e2e",
    "test:unit:watch": "vitest --project unit --watch",
    "test:unit:coverage": "vitest --project unit --coverage",
    "test:all": "vitest --run",
    "test:ci": "vitest --run --coverage",
    "test:coverage": "vitest --run --coverage --project unit --project integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "docker:create": "docker compose -f docker-compose.infra.yml up -d",
    "docker:start": "docker compose -f docker-compose.infra.yml start",
    "docker:stop": "docker compose -f docker-compose.infra.yml stop",
    "prepare": "husky",
    "email": "npx email dev --dir components/emails --port 3001"
  },
  "dependencies": {
    "@axiomhq/js": "^1.6.0",
    "@axiomhq/logging": "^0.2.0",
    "@axiomhq/nextjs": "^0.2.1",
    "@axiomhq/react": "^0.2.0",
    "@base-ui/react": "^1.4.1",
    "@better-auth/infra": "^0.2.5",
    "@hugeicons-pro/core-bulk-rounded": "^4.1.0",
    "@hugeicons-pro/core-solid-rounded": "^4.1.0",
    "@hugeicons-pro/core-stroke-rounded": "^4.1.0",
    "@hugeicons/react": "^1.1.6",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@scalar/nextjs-api-reference": "^0.10.14",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.100.9",
    "@tiptap/extension-task-item": "^3.23.4",
    "@tiptap/extension-task-list": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "argon2": "^0.44.0",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "eslint-config-next": "^16.2.5",
    "frimousse": "^0.3.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "rate-limiter-flexible": "^11.1.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-email": "^6.1.1",
    "redis": "^5.12.1",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "shadcn": "4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "effect": "^3.21.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "argon2",
      "esbuild",
      "msw",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1043.0",
    "@biomejs/biome": "2.4.13",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@faker-js/faker": "^10.4.0",
    "@react-email/ui": "6.0.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "4.1.5",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "prisma": "7.8.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
